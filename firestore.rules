rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && request.auth.uid in coupleDoc(coupleId).data.members;
    }

    match /users/{uid} {
      allow create, read, update: if isSelf(uid);
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow get: if signedIn()
        && request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.inviteCode is string;

      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['relationshipDate', 'updatedAt'])
        )
        ||
        (
          resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'inviteCode', 'updatedAt'])
          && resource.data.inviteCode is string
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.coupleId == coupleId
        )
      );

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /records/{recordId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isCoupleMember(coupleId);
      }
    }

    match /invites/{code} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.code == code;

      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (
          resource.data.active == true
          && request.resource.data.active == false
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.coupleId == resource.data.coupleId
          && request.resource.data.code == resource.data.code
          && request.resource.data.usedBy == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.members
          && getAfter(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.members.size() == 2
        )
      );

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
